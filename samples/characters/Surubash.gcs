				"points": -5
			}
		},
		{
			"id": "tZ4az4hdAiuHhfNNt",
			"name": "Says \"I was out with Qara\" the way another man says he walked a fence line",
			"local_notes": "No vocabulary, no doctrine, no anxiety. He does not say warg, he does not say özyoq (self-absent), and he does not know either word.",
			"tags": [
				"Quirk"
			],
			"base_points": -1,
			"calc": {
				"points": -1
			}
		},
		{
			"id": "tbn5znF_5OhrafgkV",
			"name": "Has no word for what he does and does not want one",
			"local_notes": "**This is the whole NPC.** He is Stürm's exact opposite: the same faculty, one rung further along, and no theology attached to it at all. Stürm believes his nights are evidence that he is closing - a mind in two bodies where there should be two things - and therefore saghlik (the end of the world) in miniature. Surubash has been doing it on purpose since he was thirty-three.",
			"tags": [
				"Quirk"
			],
			"base_points": -1,
			"calc": {
				"points": -1
			}
		},
		{
			"id": "tr4BDcGc6ROelE7_U",
			"name": "Will not name the dogs to outsiders",
			"local_notes": "The suruchin (those-whose-work-is-the-herd) is the same word for the dogs and for the men who herd, in the same tone. Who is doing the work is a southern question.",
			"tags": [
				"Quirk"
			],
			"base_points": -1,
			"calc": {
				"points": -1
			}
		},
		{
			"id": "tpEpRU5xVav3a2vZe",
			"name": "Sleeps against the dogs",
			"local_notes": "Which is also how he sleeps on hard ground without anybody bringing him turf.",
			"tags": [
				"Quirk"
			],
			"base_points": -1,
			"calc": {
				"points": -1
			}
		},
		{
			"id": "t04RGJX1dzg_ILa9L",
			"name": "Speaks to priests exactly as he speaks to drovers",
			"local_notes": "He is lay, he is beneath all three grades, and he has never once noticed that he is supposed to be careful.",
			"tags": [
				"Quirk"
			],
			"base_points": -1,
			"calc": {
				"points": -1
			}
		}
	],
