				"id": "t4gqkFmqABx7dLjkS"
			},
			"name": "Stubbornness",
			"reference": "B157",
			"local_notes": "He has been right about where the herd is for twenty-six years. B157",
			"tags": [
				"Disadvantage",
				"Mental"
			],
			"base_points": -5,
			"features": [
				{
