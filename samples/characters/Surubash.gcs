	"traits": [
		{
			"id": "tS7055gy7tU6RK-WB",
			"name": "Animal Companion (Qara)",
			"reference": "GOT2",
			"local_notes": "Qara (black), the lead bitch, eleven years his. Her own stats, GM control, exceptionally loyal; +1 to his melee attacks while she is adjacent and engaged with the same foe. If she dies the advantage and its 5 points are lost and cannot be recovered without a new bond. Prerequisite for Warg. (Wargs, Skinchangers & Green Sight, p.2)",
			"tags": [
				"Advantage",
				"Supernatural"
			],
			"base_points": 5,
			"calc": {
				"points": 5
			}
		},
		{
			"id": "t9CLBi_taEesS2cR2",
			"name": "Warg",
			"reference": "GOT4",
			"local_notes": "Deliberate, controlled entry into Qara (black), awake, in daylight, and back out whenever he chooses. 1 second of Concentration; his own body goes unconscious and unaware. He uses her body, senses and physical advantages and keeps his own IQ, Will, memories and skills. A Major Wound or crippling injury to her breaks it: he snaps back and takes 1 FP. Warg does NOT reach any other animal - that is Skinchanger [20], which he does not have and should never get. (Wargs, Skinchangers & Green Sight, p.4)",
			"tags": [
				"Advantage",
				"Supernatural"
			],
			"base_points": 15,
			"calc": {
				"points": 15
			}
		},
		{
			"id": "t_dJEZUtMobZFp-ed",
			"source": {
				"library": "richardwilkes/gcs_master_library",
				"path": "Basic Set/Basic Set Traits.adq",
				"id": "tZTGYpVyvbfhURaxn"
			},
			"name": "Animal Empathy",
			"reference": "B40,P48",
			"local_notes": "Not the supernatural bit - the ordinary one. He reads any animal on sight, which is why the Locke kennelmaster's hounds keep losing what his find. B40",
