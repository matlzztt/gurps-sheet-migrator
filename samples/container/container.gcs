					"quantity": 1,
					"equipped": true,
					"children": [
						{
							"id": "eMNPcBPVkCDd_WRHP",
							"description": "The Book of Lines",
							"local_notes": "A gathering of scraped vellum in a hide cover, kept against the yarqap. Westerosi, because Kesmen (cut-lines) has no script — a small square hand that stopped improving at eleven.",
							"legality_class": "4",
							"quantity": 1,
							"equipped": true,
							"calc": {
								"value": 0,
