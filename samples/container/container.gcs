				"points": -10
			}
		},
		{
			"id": "tBxQJcSRURX3E-lAf",
			"name": "Vow (Great)",
			"local_notes": "The third and fourth yasakh (that-which-is-forbidden): he may not open a body unasked, and he may not refuse a request to open a living body. Binds the opener, so it binds a Menkhu. Any character who says it aloud has compelled him. B160",
			"base_points": -15,
			"calc": {
				"points": -15
			}
		}
