			"name": "Trait Container",
			"children": [
				{
					"id": "tqSpM2benfhhMyiq1",
					"name": "Green Sight",
					"local_notes": "Whenever you sleep, roll 1d6. On a 6, you experience either a Premonition or a Portent.\nPremonitions are simple dreams dominated by emotions, sensations, and vague impressions rather than clear images.\nAfter experiencing a Premonition, choose one roll you make during the following day. You receive +3 to that\nroll. \nPortents. Portents are true prophetic dreams: powerful visions of events that are happening or are about to\nhappen. ",
					"base_points": 15,
					"calc": {
						"points": 15
					}
				},
				{
					"id": "tdfQMngmrK5O0WWc9",
					"name": "Language: Westerosi Common",
					"reference": "B24",
					"local_notes": "Spoken (Native) 3 + Written (Accented) 2. B24",
					"base_points": 5,
					"calc": {
						"points": 5
					}
				}
