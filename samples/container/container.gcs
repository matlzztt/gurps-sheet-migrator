		{
			"id": "t8X5UTiAr4DiqJ-Xo",
			"name": "Vow (Major)",
			"local_notes": "The sixth yasakh: he may not sleep on hard ground. Turokh (the Earth) is underneath, and where the ground is hard he is not there to lie on. B160",
			"base_points": -10,
			"calc": {
				"points": -10
			}
